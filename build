#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# headnumatic – release build script
#
# Usage: ./build <Y|N>
#
# Steps:
#   1. Read current version from manifest.json
#   2. Increment the patch version component
#   3. Write the new version back to manifest.json and package.json
#   4. Record the new version in versions.json (only when the argument is Y)
#   4b. Promote CHANGELOG.md's [Unreleased] section to the new version
#   5. Type-check TypeScript (no emit)
#   6. Bundle with esbuild (production)
#   7. Copy distributable files to ./build-output/
# ---------------------------------------------------------------------------

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# ── 0. Argument ──────────────────────────────────────────────────────────────
usage() {
  cat <<'EOF'
Usage: ./build <Y|N>

  Y   after bumping manifest.json, add the new version to versions.json
      (mapped to the manifest's minAppVersion, which is what Obsidian uses
      to decide the newest release a given app version may install)
  N   leave versions.json untouched

The argument is required so the versions.json update is always a deliberate
choice. Either way the script bumps the patch version in manifest.json and
package.json, type-checks, bundles with esbuild, and fills build-output/.
EOF
}

UPDATE_VERSIONS="${1:-}"

if [[ -z "$UPDATE_VERSIONS" ]]; then
  usage
  exit 1
fi

case "$UPDATE_VERSIONS" in
  Y|y) UPDATE_VERSIONS="Y" ;;
  N|n) UPDATE_VERSIONS="N" ;;
  *)
    echo "Unrecognised argument: '${UPDATE_VERSIONS}'" >&2
    echo "" >&2
    usage >&2
    exit 1
    ;;
esac

# ── 1. Read version from manifest.json ──────────────────────────────────────
CURRENT_VERSION="$(node -e "process.stdout.write(JSON.parse(require('fs').readFileSync('manifest.json','utf8')).version)")"

# Split into major.minor.patch
IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT_VERSION"

# ── 2. Increment patch ───────────────────────────────────────────────────────
PATCH=$(( PATCH + 1 ))
NEW_VERSION="${MAJOR}.${MINOR}.${PATCH}"

echo "Bumping version: ${CURRENT_VERSION} → ${NEW_VERSION}"

# ── 3. Write new version to files ───────────────────────────────────────────

# manifest.json
node -e "
const fs = require('fs');
const m = JSON.parse(fs.readFileSync('manifest.json', 'utf8'));
m.version = '${NEW_VERSION}';
fs.writeFileSync('manifest.json', JSON.stringify(m, null, 2) + '\n');
"

# package.json
node -e "
const fs = require('fs');
const pkg = JSON.parse(fs.readFileSync('package.json', 'utf8'));
pkg.version = '${NEW_VERSION}';
fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2) + '\n');
"

# ── 4. versions.json (opt-in) ────────────────────────────────────────────────
if [[ "$UPDATE_VERSIONS" == "Y" ]]; then
  node -e "
const fs = require('fs');
const manifest = JSON.parse(fs.readFileSync('manifest.json', 'utf8'));
const versions = JSON.parse(fs.readFileSync('versions.json', 'utf8'));
versions['${NEW_VERSION}'] = manifest.minAppVersion;
fs.writeFileSync('versions.json', JSON.stringify(versions, null, 2) + '\n');
"
  echo "versions.json: added ${NEW_VERSION}"
else
  echo "versions.json: left unchanged"
fi

# ── 4b. CHANGELOG.md ────────────────────────────────────────────────────────
# Promote whatever sits under "## [Unreleased]" to the new version number and
# leave a fresh empty [Unreleased] heading above it.  The release workflow
# publishes that section as the GitHub release description.
#
# The headings are matched anchored to the start of a line, so prose that
# merely mentions "## [Unreleased]" is not mistaken for the heading itself.
if [[ -f CHANGELOG.md ]]; then
  NEW_VERSION="$NEW_VERSION" node <<'NODE'
const fs = require('fs');

const version = process.env.NEW_VERSION;
const unreleasedRe = /^## \[Unreleased\][ \t]*$/m;
const versionRe = new RegExp('^## \\[' + version.replace(/\./g, '\\.') + '\\]', 'm');

let text = fs.readFileSync('CHANGELOG.md', 'utf8');

if (versionRe.test(text)) {
  console.log('CHANGELOG.md: section for ' + version + ' already present, left unchanged');
} else if (!unreleasedRe.test(text)) {
  console.log('CHANGELOG.md: no [Unreleased] heading found, left unchanged');
} else {
  const today = new Date().toISOString().slice(0, 10);
  text = text.replace(unreleasedRe, '## [Unreleased]\n\n## [' + version + '] - ' + today);
  fs.writeFileSync('CHANGELOG.md', text);
  console.log('CHANGELOG.md: [Unreleased] promoted to ' + version);
}
NODE
else
  echo "CHANGELOG.md: not found, skipped"
fi

# ── 5. TypeScript type-check ─────────────────────────────────────────────────
echo "Type-checking TypeScript…"
npx tsc --noEmit --skipLibCheck

# ── 6. esbuild production bundle ─────────────────────────────────────────────
echo "Bundling with esbuild (production)…"
node esbuild.config.mjs production

# ── 7. Assemble build-output/ ────────────────────────────────────────────────
OUTPUT_DIR="build-output"
rm -rf "$OUTPUT_DIR"
mkdir -p "$OUTPUT_DIR"

cp main.js    "$OUTPUT_DIR/main.js"
cp manifest.json "$OUTPUT_DIR/manifest.json"

if [[ -f styles.css ]]; then
  cp styles.css "$OUTPUT_DIR/styles.css"
fi

echo ""
echo "Build complete → ${OUTPUT_DIR}/"
echo "  Version : ${NEW_VERSION}"
ls -lh "$OUTPUT_DIR"
